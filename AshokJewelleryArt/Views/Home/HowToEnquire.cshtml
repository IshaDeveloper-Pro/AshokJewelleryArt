@* For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860 *@

@{
    ViewData["Title"] = "How to Enquire | Ashok Jewellery Art";
}

@section Styles {
    <link rel="stylesheet" href="~/css/HowToEnquire.css" asp-append-version="true" />
}

<div class="enquiry-page-wrapper">
    <header class="enquiry-hero">
        <div class="hero-overlay">
            <h1>Bringing your dream jewelry to life is just a conversation away.</h1>
            <p>Experience personalized luxury with Ashok Jewellery Art.</p>
        </div>
    </header>

    <section class="process-section">
        <div class="container">
            <h2 class="section-title">Our Simple Enquiry Process➡</h2>
            <div class="steps-grid">
                <div class="step-card">
                    <div class="icon-box">
                        <i class="fa-solid fa-gem"></i>
                    </div>
                    <h3>Step 1: Discover</h3>
                    <p>Browse our exclusive collections, choose your favorite design, and note down the unique Product Reference Code.</p>
                </div>

                <div class="step-card">
                    <div class="icon-box">
                        <i class="fa-brands fa-whatsapp"></i>
                    </div>
                    <h3>Step 2: Connect</h3>
                    <p>Click the WhatsApp button on the product page or message us directly with the reference code to start your inquiry.</p>
                </div>

                <div class="step-card">
                    <div class="icon-box">
                        <i class="fa-solid fa-comments-dollar"></i>
                    </div>
                    <h3>Step 3: Consultation</h3>
                    <p>Our experts will contact you to confirm the metal weight, purity certificates, and final price based on the daily gold rate.</p>
                </div>
            </div>
        </div>
    </section>

    <section class="trust-note-section">
        <div class="trust-container">
            <div class="trust-content">
                <i class="fa-solid fa-shield-heart"></i>
                <h2>Why No Direct Buy?</h2>
                <p >"Every piece of jewelry tells a story. We personally connect with our clients before finalizing orders to ensure absolute transparency in purity and to offer the best value based on current market rates."</p>
            </div>
        </div>
    </section>
</div>