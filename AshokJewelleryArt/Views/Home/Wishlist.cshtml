<script>
$(document).ready(function() {
        renderWishlist();
        if (typeof updateWishlistCount === 'function') {
            updateWishlistCount();
        }
    });
    function renderWishlist() {
        let items = JSON.parse(localStorage.getItem('userWishlist')) || [];
        let container = $('#wishlist-container');

        container.empty();

        if (items.length === 0) {
            container.html("<div class='col-12 text-center mt-5'><h3>Your Wishlist is empty! 💍</h3></div>");
        } else {
            items.forEach(item => {
                container.append(`
                    <div class="col-xl-3 col-lg-4 col-md-6 col-sm-12 mb-4 wishlist-card-col">
                        <div class="premium-card" style="border: 1px solid #eee; background: #fff; border-radius: 8px; overflow: hidden; height: 100%;">
                            <div class="image-frame" style="height: 250px; display: flex; align-items: center; justify-content: center; background: #fafafa;">
                                <img src="${item.image}" alt="${item.name}" style="max-width: 100%; max-height: 100%; object-fit: contain;" />
                            </div>
                            <div class="item-details" style="padding: 15px; text-align: center;">
                                <h5 style="font-size: 1.1rem; margin-bottom: 5px;">${item.name}</h5>
                                <p style="color: #666; font-size: 0.9rem;">Weight: ${item.weight}</p>

                            <a href="/Home/Details/${item.id}" 
   style="font-size: 13px; text-decoration: underline; color: blue; font-weight: 500; transition: color 0.2s;" 
   onmouseover="this.style.color='#000'; this.style.fontWeight='600';" 
   onmouseout="this.style.color='#333'; this.style.fontWeight='500';">
    View Product
</a>
                                <button class="btn-remove-item" onclick="removeFromWishlist('${item.id}')">
                                    <i class="fa-regular fa-trash-can"></i> REMOVE
                                </button>
                            </div>
                        </div>
                    </div>
                `);
            });
        }
    }

    function removeFromWishlist(id) {
        let wishlist = JSON.parse(localStorage.getItem('userWishlist')) || [];
        wishlist = wishlist.filter(item => item.id != id);
        localStorage.setItem('userWishlist', JSON.stringify(wishlist));

        showWishlistMessage("Item Removed from Wishlist!", "error");

        setTimeout(() => {
            renderWishlist();
            if (typeof updateWishlistCount === 'function') {
                updateWishlistCount();
            }
        }, 500);
    }

    // Wishlist Toast Message Popup Logic (Top-Right & Unique Name)
    let activeWishlistToast = null;

    function showWishlistMessage(text, type) {
        if (activeWishlistToast) {
            activeWishlistToast.remove();
        }

        activeWishlistToast = document.createElement('div');
        activeWishlistToast.innerText = text;
        
        activeWishlistToast.style.position = 'fixed';
        activeWishlistToast.style.top = '30px';
        activeWishlistToast.style.right = '30px';
        activeWishlistToast.style.padding = '12px 24px';
        activeWishlistToast.style.color = '#fff';
        activeWishlistToast.style.borderRadius = '6px';
        activeWishlistToast.style.zIndex = '999999';
        activeWishlistToast.style.fontFamily = 'sans-serif';
        activeWishlistToast.style.fontSize = '14px';
        activeWishlistToast.style.boxShadow = '0 4px 12px rgba(0,0,0,0.15)';
        activeWishlistToast.style.transition = 'opacity 0.3s ease';

        if (type === 'error') {
            activeWishlistToast.style.backgroundColor = '#e74c3c'; // Red for remove
        } else {
            activeWishlistToast.style.backgroundColor = '#1e3d2f'; // Dark Emerald for success if any
            activeWishlistToast.style.color = '#a8e6cf';
        }

        document.body.appendChild(activeWishlistToast);

        setTimeout(() => {
            if (activeWishlistToast) {
                activeWishlistToast.style.opacity = '0';
                setTimeout(() => {
                    if (activeWishlistToast) {
                        activeWishlistToast.remove();
                        activeWishlistToast = null;
                    }
                }, 300);
            }
        }, 3000);
    }

    function goBack() {
        if (document.referrer.indexOf(window.location.host) !== -1) {
            window.history.back();
        } else {
            window.location.href = '/Home/Index';
        }
    }
    </script>