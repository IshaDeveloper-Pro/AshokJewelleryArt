@section Styles {
    <link rel="stylesheet" href="~/css/ContactUs.css?v=@(DateTime.Now.Ticks)" asp-append-version="true" />
}
<section class="contact-page-section">
    <div class="contact-hero-header">
        <h1 class="premium-title">Contact Us</h1>
        <p class="premium-subtitle">Visit our showroom or send us an enquiry for bespoke designs.</p>
    </div>

    <div class="contact-main-wrapper">
        <div class="contact-container">
            <div class="contact-info-panel">
                <div class="info-top-image">
                    <img src="/images/contactimg3.jpg" alt="Ashok Jewellery Art Showroom" />
                </div>

               <div class="AjTitle">
                    <h2 class="Aj-Title">Ashok Jewellery Art</h2>

               </div>
                <div class="info-details">
                    <h2 class="panel-title">Our Showroom</h2>
                    <div class="info-block">
                        <h4>LOCATION</h4>
                        <p>Anshuman Market, Near Mungasaji Maharaj Temple,<br>Nandgaon Kh., Dist.-Amravati.</p>
                    </div>
                    
                    <div class="info-block">
                        <h4>BUSINESS HOURS</h4>
						<p>Monday - Sunday<br>Time: 11:00 AM - 8:30 PM</p>
                    </div>

                    <div class="info-block">
                        <h4>CONTACT DIRECTLY</h4>
                        <p>
                            Phone: <a href="tel:+919890451915" onclick="return confirm('Do you want to make a call to this number?');" style="color: inherit; text-decoration: none;">+91 9890451915</a><br>
                            Email: <a href="mailto:official.ashokjewellery.art1990@gmail.com" onclick="return confirm('Do you want to send an email?');" style="color: inherit; text-decoration: none;">official.ashokjewellery.art1990@gmail.com</a>
                        </p>
                    </div>
                </div>
                <div class="map-wrapper">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d15443.076840706596!2d77.81059911964107!3d20.686526186414736!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3bd6a4c264a75ccb%3A0x6b78d2b27a3c3328!2sShri%20Sant%20Mungsaji%20Maharaj%20Mandir%20Nandgaon%20Khandeshwar!5e0!3m2!1sen!2sin!4v1714152857000!5m2!1sen!2sin"
                            width="100%"
                            height="250"
                            style="border:0;"
                            allowfullscreen=""
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade">
                    </iframe>
                </div>
            </div>

            <div class="contact-form-panel">
                <h3 class="panel-title">Send an Enquiry</h3>
                <p>Have a question or looking for a custom piece? Fill out the form below.</p>
                
                <form id="premiumEnquiryForm">
                    <div class="premium-form-group">
                        <label>Your Name</label>
                        <input type="text" placeholder="e.g. Gaurav Sharma" required>
                    </div>
                    
                    <div class="premium-form-group">
                        <label>Email Address</label>
                        <input type="email" placeholder="gaurav@example.com" required>
                    </div>

                    <div class="premium-form-group">
                        <label>Phone Number</label>
                        <input type="tel" placeholder="+91 XXXXX XXXXX" required>
                    </div>

                    <div class="premium-form-group">
                        <label>Your Message</label>
                        <textarea placeholder="Tell us about the jewelry you're interested in..." rows="6" required></textarea>
                    </div>
                    
                    <button type="submit" class="premium-submit-btn">SEND ENQUIRY</button>
                </form>
            </div>
        </div>
    </div>
</section>

<script>
    function handleEnquirySubmit(event) {
        var form = document.getElementById('premiumEnquiryForm');

        if (!form.checkValidity()) {
            return true; 
        }

        event.preventDefault(); 

        let userConfirm = confirm('Are you sure you want to submit this enquiry?');

        if (userConfirm) {
            alert('Your enquiry has been sent successfully! We will get back to you soon.');

            // Reset the form
            form.reset();
        }

        return false;
    }
</script>
<a asp-controller="Home" asp-action="Index" class="floating-home-btn" title="Back to Home">
    <svg class="home-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
        <path d="M11.47 3.84a.75.75 0 011.06 0l8.69 8.69a.75.75 0 11-1.06 1.06l-.97-.97v7.13c0 .966-.784 1.75-1.75 1.75H15.5a.75.75 0 01-.75-.75v-4.5a.75.75 0 00-.75-.75h-2a.75.75 0 00-.75.75v4.5a.75.75 0 01-.75.75H6.25A1.75 1.75 0 014.5 19.75v-7.13l-.97.97a.75.75 0 01-1.06-1.06l8.69-8.69z" />
    </svg>
    <span>Home</span>
</a>