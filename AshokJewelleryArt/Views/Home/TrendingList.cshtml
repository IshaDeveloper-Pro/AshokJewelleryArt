@model IEnumerable<AshokJewelleryArt.Models.Product>
<div class="trending-full-list">

<!-- NAVIGATION BUTTONS START -->
<div class="nav-wrapper" style="padding: 20px 0; text-align: right; width: 100%;">
    
    <!-- 1. CONTINUE SHOPPING BUTTON -->
    <button onclick="goBack()" class="btn-back-luxury" style="position: static !important; float: none !important; display: inline-flex !important; align-items: center; gap: 8px; margin-right: 8px !important;font-weight:700;">
        <i class="fa-solid fa-arrow-left-long"></i>
        CONTINUE TO COLLECTIONS
    </button>

    <!-- 2. BACK BUTTON -->
    <a href="/Home/Index" class="btn-back-luxury" style="position: static !important; float: none !important; display: inline-flex !important; align-items: center; gap: 8px; text-decoration: none; background-color:khaki; font-weight:700;">
        <i class="fa-solid fa-house"></i>
        BACK
    </a>

</div>
<!-- NAVIGATION BUTTONS END -->
    <div class="luxury-title-wrapper">
        <div class="title-line"></div>
        <div class="title-content">
            <span class="sub-title">Handpicked Collections</span>
            <h2 class="main-title">OUR TRENDING MASTERPIECES</h2>
        </div>
        <div class="title-line"></div>
    </div>
    <div class="premium-filter-strip">
       
         <div class="filter-center-group">
            <!-- WEIGHT RANGE Dropdown -->
            <div class="luxury-select-wrapper">
                <i class="fa-solid fa-sliders filter-left-icon"></i>
                <select id="weightPill" class="luxury-select" onchange="applyTrendingFilters()">
                    <option value="">WEIGHT RANGE</option>
                    <option value="0-5">0 - 5 (g / ct)</option>
                    <option value="5-10">5 - 10 (g / ct)</option>
                    <option value="10-20">10 - 20 (g / ct)</option>
                    <option value="20+">ABOVE 20 (g / ct)</option>
                </select>
                <i class="fa-solid fa-chevron-down custom-arrow"></i>
            </div>

            <!-- METAL TYPE Dropdown -->
            <div class="luxury-select-wrapper" style="margin-left: 25px;">
                <i class="fa-solid fa-sliders filter-left-icon"></i>
                <select id="metalPill" class="luxury-select" onchange="applyTrendingFilters()">
                    <option value="">METAL TYPE</option>
                    <option value="Gold">GOLD</option>
                    <option value="Diamond">DIAMOND</option>
                    <option value="Silver">SILVER</option>
                    <option value="Gemstone">GEMSTONE</option>
                </select>
                <i class="fa-solid fa-chevron-down custom-arrow"></i>
            </div>

            <button onclick="applyTrendingFilters()" class="luxury-apply-btn">APPLY</button>
        </div>

        <div class="filter-right">
            <button onclick="resetTrendingFilters()" class="luxury-reset-link">RESET ALL</button>
        </div>
    </div>
    @*FILTERS END*@
@if (Model == null || !Model.Any())

    {

        <div class="text-center">

            <p>Data Empty! </p>

        </div>

    }

    else

    {

        <div class="beige-grid">
            @foreach (var item in Model)
            {
                bool isTrendingCarat = false;

                if (item.Category != null && (item.Category.ToLower().Contains("diamond") || item.Category.ToLower().Contains("gemstone")))
                {
                    isTrendingCarat = true;
                }

                if (item.MetalType != null && (item.MetalType.ToLower().Contains("diamond") || item.MetalType.ToLower().Contains("gemstone")))
                {
                    isTrendingCarat = true;
                }

                string trendingUnit = isTrendingCarat ? "ct" : (!string.IsNullOrEmpty(item.WeightUnit) ? item.WeightUnit : "g");
                string weightDisplay = $"{item.Weight} {trendingUnit}";

                <div class="premium-card">
                    <div class="wishlist-icon-container"
                         onclick="addToWishlist('@item.Id', '@item.Name', '@item.ImageURL', '@weightDisplay')">
                        <i class="fa-regular fa-heart"></i>
                    </div>

                    <div class="image-frame">
                        <img src="@item.ImageURL" alt="@item.Name" class="main-img" />
                    </div>

                    <div class="item-details">
                        <h3 class="p-name">@item.Name</h3>

                        <p class="p-category">
                            <span style="color: #d4af37; font-weight: bold;">@item.MetalType</span> |
                            @item.SubCategory (@item.Category)
                        </p>

                        <p class="p-weight">Weight: @weightDisplay</p>

                        <a href="/Home/TrendingCollection?id=@item.Id" class="btn-view-product">VIEW PRODUCT</a>
                    </div>
                </div>
            }
        </div>

  }


<style>

