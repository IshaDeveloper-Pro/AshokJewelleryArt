<script>
        // Product card  click event
       function addToWishlist(id, name, img, weight) {
        let wishlist = JSON.parse(localStorage.getItem('userWishlist')) || [];

        if (!wishlist.some(item => item.id === id)) {
            wishlist.push({
                id: id,
                name: name,
                image: img,
                weight: weight
            });
            localStorage.setItem('userWishlist', JSON.stringify(wishlist));
    showMessage(name + " Added in Your Wishlist! ❤️");           
    updateWishlistCount();
        } else {
            showMessage(" This item already available in your Wishlist!", "error");
            
        }
    }

    
    function goBack() {
      window.location.href = '/Home/TrendingList';
    }
    //FILTER-->
        function applyTrendingFilters() {
        const urlParams = new URLSearchParams(window.location.search);
    
        let gender = document.getElementById('genderPill').value;
        let price = document.getElementById('pricePill').value;
        let metal = document.getElementById('metalPill').value;

        let params = [];
        if (gender) params.push(`gender=${gender}`);
        if (price) params.push(`priceRange=${price}`);
        if (metal) params.push(`metalType=${metal}`); 

        window.location.href = `/Home/TrendingList?` + params.join('&');
    }

            function applyTrendingFilters() {
                let weight = document.getElementById('weightPill').value;
                let metal = document.getElementById('metalPill').value;

                let params = [];
                if (weight) params.push(`weight=${weight}`);
                if (metal) params.push(`metalType=${metal}`);

                let url = '/Home/TrendingList';
                if (params.length > 0) {
                    url += '?' + params.join('&');
                }

                window.location.href = url;
            }

            function resetTrendingFilters() {
                window.location.href = '/Home/TrendingList';
            }

            document.addEventListener("DOMContentLoaded", function() {
                const urlParams = new URLSearchParams(window.location.search);

                let weightVal = urlParams.get('weight');
                let metalVal = urlParams.get('metalType');

                if (weightVal) {
                    let weightSelect = document.getElementById('weightPill');
                    if (weightSelect) weightSelect.value = weightVal;
                }

                if (metalVal) {
                    let metalSelect = document.getElementById('metalPill');
                    if (metalSelect) metalSelect.value = metalVal;
                }
            });






    function toggleAjFilter() {
    var filterGroup = document.querySelector('.filter-center-group');
    var filterRight = document.querySelector('.filter-right');

    // Toggle active class for smooth opening/closing
    if (filterGroup) {
        filterGroup.classList.toggle('active');
    }
    if (filterRight) {
        filterRight.classList.toggle('active');
    }
}

function goBack() {
    window.location.href = '/Home/Index#trending-section-target';
}
</script>
