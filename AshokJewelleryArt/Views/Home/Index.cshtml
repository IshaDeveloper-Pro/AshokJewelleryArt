@*NEW ARRIVAL SECTION*@
<div class="section-header">
    <div class="title-flex">
        <img src="/images/STARicon1.gif" class="stars-icon" alt="star"> <h2 class="main-title">NEW ARRIVALS</h2> <img src="/images/STARicon1.gif" class="stars-icon" alt="star">
    </div>
    <div class="title-underline"></div>
</div>

<div class="slider-container-arrival">
    <button class="ctrl-btn prev" onclick="moveSlider(-1)">&#10094;</button>
    <div class="arrival-wrapper" id="newArrivals">
        @foreach (var product in Model.NewArrivals)
        {
            <a href="/Home/Details?id=@product.Id" class="product-col" style="text-decoration: none; color: inherit;">
                <div class="product-img">
                    <img src="@product.ImageURL" style="width: 300px; height: 300px; object-fit: cover;" alt="@product.Name">
                </div>

                <div class="product-metal" style="font-size: 13px; color: #b08d57; font-weight: 600; text-transform: uppercase; margin-top: 8px; letter-spacing: 1px;">
                    @product.MetalType
                </div>

                <div class="product-name" style="margin-top: 2px;">@product.Name</div>
            </a>
        }
    </div>
    <button class="ctrl-btn next" onclick="moveSlider(1)">&#10095;</button>
</div>

@*Trending collection*@
<div id="trending-section-target"  class="trending-main-wrapper">
    <section class="trending-section">
        <div class="trending-flex-container">
            
            <div class="trending-left-panel">
                <div class="title-container">
                    <img src="/images/icondiamond1.gif" class="diamond-icon" alt="diamond">
                    <h2 class="section-title">Trending Collection</h2>
                    <img src="/images/icondiamond1.gif" class="diamond-icon" alt="diamond">
                </div>

                <div class="video-transition-box">
                   <video autoplay loop muted playsinline controls class="trending-video">
                        <source src="/images/trendingvideo1.mp4" type="video/mp4">
        Your browser does not support the video tag.
    </video>
                </div>

                <div class="style-promo-card over-layout">
                    <div class="text-content-area">
                        <span class="text-regular">JEWELLERY THAT SUITS</span>
                        <h4 class="text-script">Your style</h4>
                    </div>
        
                    <div class="image-with-shape-wrap">
                        <img src="/images/modernjwe5.jpg" alt="Style Model" class="organic-img">
                    </div>
                </div>
            </div>
            <div class="trending-right-panel">
                <div class="beige-grid">
        
                    @if (Model.TrendingProducts != null && Model.TrendingProducts.Any())
                    {
                        @foreach (var item in Model.TrendingProducts)
                        {
                            <a asp-controller="Product" asp-action="Details" asp-route-id="@item.Id"  class="aj-card-link">
                                <div class="premium-card">
                                    <div class="image-frame">
                                        @* Background Blur Fix *@
                                        <div class="bg-blur" style="background-image: url('@item.ImageURL');"></div>
                            
                                        @* Main Image *@
                                        <img src="@item.ImageURL" alt="@item.Name" class="main-img">
                                    </div>
                                    <div class="item-details">
                                        <h3 class="p-name">@item.Name</h3>
                                        <p class="p-weight">Weight: @item.Weight</p>
                                      
                                        <p class="p-MetalType">@item.MetalType-Collection</p>
                                    </div>
                                </div>
                            </a>
                        }
                        @* <-- Loop closed *@
                    }
                    else
                    {
                        <div class="no-data">Bhai, Database mein koi product nahi mila!</div>
                    }

                    <div class="view-all-wrapper-right">
                       
                            <a href="/Home/TrendingList" class="btn-view-all-premium">
                                VIEW ALL COLLECTION <span class="arrow">→</span>
                            </a>
                        
                    </div>

                </div> @* <-- beige-grid close*@
            </div>

                 
        </div>
    </section>
</div>

