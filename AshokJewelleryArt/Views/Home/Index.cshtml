@model AshokJewelleryArt.Models.HomeViewModel
@{
    ViewData["Title"] = "Home Page";
}


<section class="hero-slider" style="height:auto; width:100%;">
    <div class="slider-arrow prev" onclick="moveSlide(-1)">&#10094;</div>
    <div class="slider-arrow next" onclick="moveSlide(1)">&#10095;</div>
    <div class="slider-container" style="height:auto;">
        
        <!-- Slide 1 -->
        <div class="slide">
            <picture>
                <source media="(max-width: 440px)" srcset="/images/testing2.png">

                <img src="/images/testing2.png" alt="Gold Collection">
            </picture>
        </div>

        <!-- Slide 2 -->
        <div class="slide">
            <picture>
                <source media="(max-width: 440px)" srcset="/images/showcasebanner22mobile.png">
                <img src="/images/showcasebanner22.png" alt="Diamond Collection">
            </picture>
        </div>

        <!-- Slide 3 -->
        <div class="slide">
            <picture>
                <source media="(max-width: 440px)" srcset="/images/showcasebanner12mobile.png">
                <img src="/images/showcasebanner12.png" alt="Gold Collection">
            </picture>
        </div>

        <!-- Slide 4 -->
        <div class="slide">
            <picture>
                <source media="(max-width: 440px)" srcset="/images/showcasebanner28mobile.png">
                <img src="/images/showcasebanner21.png" alt="Gold Collection">
            </picture>
        </div>

        <!-- Slide 5 -->
        <div class="slide">
            <picture>
                <source media="(max-width: 440px)" srcset="/images/showcasebanner26mobile.png">
                <img src="/images/showcasebanner3.png" alt="Gold Collection">
            </picture>
        </div>

    </div>


    <div class="slider-dots">
        <span class="dot active" onclick="currentSlide(0)"></span>
        <span class="dot" onclick="currentSlide(1)"></span>
        <span class="dot" onclick="currentSlide(2)"></span>
        <span class="dot" onclick="currentSlide(3)"></span>
        <span class="dot" onclick="currentSlide(4)"></span>
    </div>
</section>

