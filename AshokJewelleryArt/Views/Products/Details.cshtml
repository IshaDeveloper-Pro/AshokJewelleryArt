@model AshokJewelleryArt.Models.Product

<!-- Scroll fix script so the page always opens at the top -->
<script>
    // Disable browser scroll memory so it doesn't remember the previous position
    if ('scrollRestoration' in history) {
        history.scrollRestoration = 'manual';
    }

    // Force to the top immediately as the page loads
    window.scrollTo(0, 0);

    // Double-check when the DOM loads and after a slight delay
    document.addEventListener("DOMContentLoaded", function() {
        window.scrollTo({ top: 0, left: 0, behavior: 'instant' });
    });

    window.onload = function() {
        window.scrollTo({ top: 0, left: 0, behavior: 'instant' });
        setTimeout(function() {
            window.scrollTo({ top: 0, left: 0, behavior: 'instant' });
        }, 50);
    };
</script>

<div class="container product-details-wrapper" style="margin-top: 50px; margin-bottom: 50px;">
    <div class="row align-items-start  details-row-fix" style="display: flex; flex-wrap: nowrap;align-items:flex-start; ">

        <!-- LEFT SIDE: Image Section (Fixed Width) -->
        <div class="col-12 col-md-6  detail-img-col" style="padding: 15px;">
            <div id="js-details-zoom-container"
                 style="background: #ffffff; border: 1px solid #f1f1f1; border-radius: 12px; padding: 20px;
                box-shadow: 0 10px 30px rgba(0,0,0,0.05); text-align: center;
                overflow: hidden; position: relative; cursor: crosshair;
                height: 420px; width: 100%; display: flex; align-items: center; justify-content: center;">

                <img src="@Model.ImageURL"
                     id="js-details-main-img"
                     alt="@Model.Name"
                     style="max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; pointer-events: none;" />

                <button class="wish-icon-detail"
                        data-id="@Model.Id"
                        data-name="@Model.Name"
                        data-image="@Model.ImageURL"
                        data-weight="@Model.Weight">
                    <i class="fa-regular fa-heart"></i>
                </button>
            </div>
        </div>

        <!-- RIGHT SIDE: Details Section -->
        <div class="col-md-6  detail-info-col" style="padding: 20px 40px;">
            <div class="details-content">

                
                <span style="color: #D4AF37; text-transform: uppercase; letter-spacing: 2px; font-weight: bold; font-size: 14px;">
                    @Model.Category Collection
                </span>

                <h1 class="product-main-title">
                    @Model.Name
                </h1>
                <p style="color: #888; font-size: 14px; margin-bottom: 20px;">Reference: AJ-@Model.Id</p>
                <div style="font-size: 20px; color: #4b0082; font-weight: 700; margin-bottom: 30px; border-bottom: 2px solid #f8f8f8; padding-bottom: 20px; letter-spacing: 1px;">
                    <i class="fas fa-tag" style="font-size: 16px;"></i> Price on Request
                </div>
                <div style="margin-top: 20px; border-top: 1px solid #eee; padding-top: 20px; max-width: 400px;">

                    @* --- PURITY BLOCK START --- *@
                    @{
                        bool isDiamondOrGemstone = false;

                        if (Model.Category != null && (Model.Category.ToLower().Contains("diamond") || Model.Category.ToLower().Contains("gemstone")))
                        {
                            isDiamondOrGemstone = true;
                        }

                        if (Model.MetalType != null && (Model.MetalType.ToLower().Contains("diamond") || Model.MetalType.ToLower().Contains("gemstone")))
                        {
                            isDiamondOrGemstone = true;
                        }
                    }

@* Show Purity only if it is NOT Diamond or Gemstone *@
                    @if (!isDiamondOrGemstone)
                    {
                        <div style="display: flex; margin-bottom: 12px; align-items: center;">
                            <span style="color: #666; font-size: 15px; width: 120px; display: inline-block;">Purity:</span>
                            <span style="color: #333; font-weight: 700; font-size: 15px;">
                                @if (!string.IsNullOrEmpty(Model.MaterialType))
                                {
                                    @Model.MaterialType
                                }
                                else
                                {
                                    @(Model.MetalType != null && Model.MetalType.Equals("Silver", StringComparison.OrdinalIgnoreCase) ? "925 Sterling Silver" : "22K Gold")
                                }
                            </span>
                        </div>
                    }
                    @* --- PURITY BLOCK END --- *@

                    <div style="display: flex; margin-bottom: 12px; align-items: center;">
                        <span style="color: #666; font-size: 15px; width: 120px; display: inline-block;">Metal Type:</span>
                        <span style="color: #333; font-weight: 700; font-size: 15px; text-transform: uppercase;">
                            @(string.IsNullOrEmpty(Model.MetalType) ? "Gold" : Model.MetalType)
                        </span>
                    </div>

                    <div style="display: flex; margin-bottom: 12px; align-items: center;">
                        <span style="color: #666; font-size: 15px; width: 120px; display: inline-block;">Certificate:</span>
                        <span style="color: #333; font-weight: 700; font-size: 15px;">BIS Hallmarked</span>
                    </div>

                </div>


                <!-- Weight Info (Jewellery ke liye important) -->
                @{
                    // Check whether it is a Diamond or Gemstone or not
                    bool isCaratItem = (Model.Category != null && (Model.Category.ToLower().Contains("diamond") || Model.Category.ToLower().Contains("gemstone"))) ||
                                       (Model.MetalType != null && (Model.MetalType.ToLower().Contains("diamond") || Model.MetalType.ToLower().Contains("gemstone")));

                    // Setting the unit: Diamond/Gemstone -> ct, Everything else -> WeightUnit or default 'g'
                    string displayUnit = isCaratItem ? "ct" : (!string.IsNullOrEmpty(Model.WeightUnit) ? Model.WeightUnit : "g");
                }

                <div style="margin-bottom: 20px;">
                    <span style="background: #fdf7e3; color: #856404; padding: 5px 12px; border-radius: 20px; font-weight: 600; font-size: 14px;">
                        Weight: @Model.Weight @displayUnit
                    </span>
                </div>
                 
                <!--Product Description-->
                <div style="margin-bottom: 30px;">
                    <h6 style="font-weight: bold; color: #555;">Product Description</h6>
                    <p style="color: #777; line-height: 1.6; font-size: 15px; max-width: 380px;">
                        @if (!string.IsNullOrEmpty(Model.Description))
                        {
                            @Model.Description
                        }
                        else
                        {
                            @($"Handcrafted {Model.Name} with fine finish and premium quality by Ashok Jewellery Art. Perfect choice for daily elegance and special occasions.")
                        }
                    </p>
                </div>
                <!--Product Description End-->
                @{
                    string ownerNumber = "917588752373"; // Real owner number

                    // Yeh hamesha Products controller ka clean aur standard link banayega (chahe user kahin se bhi aaye)
                    string pageUrl = Url.Action("Details", "Products", new { id = Model.Id }, Context.Request.Scheme)!;

                    string waMessage = $"Hello Ashok Jewellery Art, I'm interested in {Model.Name} (Reference: AJ-{Model.Id}, Category: {Model.Category}). " +
                                       $"Can you please share the current price and details?\n\n" +
                                       $"Product Link: {pageUrl}";

                    string encodedMsg = Uri.EscapeDataString(waMessage);
                    string waUrl = $"https://wa.me/{ownerNumber}?text={encodedMsg}";
                }

                <a href="@waUrl" target="_blank" class="btn-whatsapp-premium"  onclick="return confirm('Are you sure you want to chat on WhatsApp for this product?')";>
                    <img src="https://upload.wikimedia.org/wikipedia/commons/6/6b/WhatsApp.svg" width="25" style="margin-right: 10px;">
                    Ask Price on WhatsApp
                </a>

                <!-- Update your Back to Collection button on the Details page to use standard ASP.NET tag helpers -->
                <div style="margin-top: 20px; text-align: center;">
                  <!-- Details Page Button -->
<a asp-controller="Products" 
   asp-action="Index" 
   id="js-btn-back-to-collection" 
   class="btn btn-outline-secondary">
    ← Back to Collection
</a>
                </div>
            </div>
        </div>

    </div>
</div>
