	<script>
			function updateWishlistCount() {
				const wishlist = JSON.parse(localStorage.getItem('userWishlist')) || [];
				const count = wishlist.length;

				// 1. Desktop Wishlist Badge Update
				const countElement = document.getElementById('wishlist-count');
				if (countElement) {
					countElement.innerText = count > 0 ? count : '';
					if (count > 0) {
						countElement.style.setProperty('display', 'flex', 'important');
					} else {
						countElement.style.setProperty('display', 'none', 'important');
					}
				}

				// 2. Mobile Wishlist Badge Update
				const mobCountElement = document.getElementById('wishlist-count-mob');
				if (mobCountElement) {
					mobCountElement.innerText = count > 0 ? count : '';
					if (count > 0) {
						mobCountElement.style.setProperty('display', 'flex', 'important');
					} else {
						mobCountElement.style.setProperty('display', 'none', 'important');
					}
				}
			}

			document.addEventListener('DOMContentLoaded', function() {
				updateWishlistCount();
			});
	</script>

	<script>
			function showMessage(msg, type = 'success') {
				let container = document.getElementById('toast-container');
				let toast = document.createElement('div');
				toast.className = `custom-toast ${type === 'error' ? 'error' : ''}`;

				// Icon logic
				let icon = type === 'success' ? 'fa-circle-check' : 'fa-circle-exclamation';

				toast.innerHTML = `
				<i class="fa-solid ${icon}"></i>
				<span>${msg}</span>`;
				container.appendChild(toast);

  
				setTimeout(() => {
					toast.style.animation = "fadeOut 0.5s ease-out forwards";
					setTimeout(() => toast.remove(), 500);
				}, 3000);
			}

	</script>

   
	<script>
			//DEATAILS PAGE  BACK TO COLLECTION
			// 1. Save scroll position on ANY product click anywhere on the site
			document.addEventListener('click', function(e) {
				const link = e.target.closest('a');
				if (link && link.getAttribute('href')) {
					const href = link.getAttribute('href').toLowerCase();
					if (href.includes('detail') || href.includes('product')) {
						sessionStorage.setItem("lastProductScrollPos", window.scrollY);
					}
				}
			});

			// 2. Restore scroll position when coming back
			function restoreScrollPos() {
				const savedScrollPos = sessionStorage.getItem("lastProductScrollPos");
				if (savedScrollPos !== null) {
					const pos = parseInt(savedScrollPos);

					// Immediately scroll
					window.scrollTo(0, pos);

					setTimeout(function() {
						window.scrollTo({
							top: pos,
							behavior: 'instant'
						});
						// Position set hone ke baad storage clear karein
						sessionStorage.removeItem("lastProductScrollPos");
					}, 100);
				}
			}

			// Run when DOM is ready and when page is fully loaded (images included)
			document.addEventListener("DOMContentLoaded", restoreScrollPos);
			window.addEventListener("load", restoreScrollPos);
	</script>
	<script>
			window.addEventListener('scroll', function() {
				const header = document.querySelector('header.main-site-header');
				if (window.scrollY > 50) {
					header.classList.add('is-sticky');
				} else {
					header.classList.remove('is-sticky');
				}
			});
	</script>
	
	<script>
			function confirmAction(event, url, message) {
    if (!confirm(message)) {
        event.preventDefault(); 
        return false;
    }
    return true; 
}
	</script>

	<script src="~/js/site.js" asp-append-version="true"></script>
