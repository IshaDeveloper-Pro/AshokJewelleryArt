						<span class="ashok-text">ASHOK</span>
						<span class="gold-text">JEWELLERY ART</span>
						<span class="star-line"></span>
					</h1>
				</div>

				<!-- Right Side:  -->
				<div class="top-right-icons">
					<div class="nav-icon-group">
						<a asp-controller="Home" asp-action="AboutUs" style=" display: flex; flex-direction: column; align-items: center;">
							<i class="fa-solid fa-circle-info"></i>
							<span>About Us</span>
						</a>
					</div>

					<div class="nav-icon-group">
						<a asp-controller="Home" asp-action="ContactUs" style="text-decoration:none; display: flex; flex-direction: column; align-items: center;">
							<i class="fa-solid fa-headset"></i>
							<span>Contact</span>
						</a>
					</div>

					<div class="nav-icon-group">
						<a asp-controller="Home" asp-action="Wishlist" style="text-decoration:none; display: flex; flex-direction: column; align-items: center; position: relative;">
							<i class="fa-regular fa-heart"></i>
							<span id="wishlist-count" class="badge-count" style="display: none!important;"></span>
							<span>Wishlist</span>
						</a>
					</div>
				</div>
			</div>
