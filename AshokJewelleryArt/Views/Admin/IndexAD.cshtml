                                        <td style="padding: 8px 6px; font-size: 11px; text-align: center; vertical-align: middle; white-space: nowrap;">@(row["CreatedAt"] != DBNull.Value ? Convert.ToDateTime(row["CreatedAt"]).ToString("dd-MM-yyyy") : "-")</td>
                                        <td style="padding: 8px 6px; font-size: 11px; text-align: center; vertical-align: middle; white-space: nowrap;"><img src="@row["ImageURL"]" style="width:26px; height:26px; object-fit:cover; border-radius: 4px;"></td>
                                        <td style="padding: 8px 6px; font-size: 11px; text-align: left; vertical-align: middle; white-space: nowrap; font-weight: bold; color: #d4af37;">
                                            @(row["MetalType"] != null ? row["MetalType"].ToString() : "No Data")
                                        </td>
                                        <td style="padding: 8px 6px; font-size: 11px; text-align: left; vertical-align: middle; white-space: nowrap;">@row["Name"]</td>
                                        <td style="padding: 8px 6px; font-size: 11px; text-align: center; vertical-align: middle; white-space: nowrap;">@row["Weight"]</td>
                                        <td style="padding: 8px 6px; font-size: 11px; text-align: center; vertical-align: middle; white-space: nowrap;">₹@(row["Price"] != DBNull.Value ? Convert.ToDecimal(row["Price"]).ToString("N0") : "0")</td>
                                        <td style="padding: 8px 6px; font-size: 11px; text-align: center; vertical-align: middle; white-space: nowrap; text-transform: capitalize; color:darkcyan;font-weight:bold;">@row["Category"]</td>
                                        <td style="padding: 8px 6px; font-size: 11px; text-align: center; vertical-align: middle; white-space: nowrap;">
                                            <div style="display: flex; gap: 4px; justify-content: center;">
                                                <button type="button" class="btn-update" style="padding: 4px 6px; font-size: 10px;" onclick="handleUpdate('@row["Id"]', '@(row["Name"]?.ToString()?.Replace("'", "\\'"))', '@row["Weight"]', '@row["Price"]', '@row["MetalType"]', '@row["Category"]', '@row["MaterialType"]')">Update</button>
                                                <button type="button" class="btn-delete" style="padding: 4px 6px; font-size: 10px;" onclick="handleDelete('@row["Id"]')">Delete</button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <!-- MULTI PRODUCTS UPLOAD SECTION END -->



        <!-- CALCULATOR SECTION START -->
        <div id="calculatorSection" style="display: none; padding: 30px; background: #fdfaf3;">
            <!-- Section Title -->
            <div style="margin-bottom: 30px; text-align: center;">
                <h2 style="margin: 0; color: #1a3c34; font-family: 'Playfair Display', serif; font-size: 2.5rem; letter-spacing: 1px;">Price Calculator</h2>
                <div style="width: 80px; height: 2px; background: #b0914f; margin: 10px auto;"></div>
            </div>

            <!-- Main Premium Card -->
            <section style="max-width: 1000px; margin: 0 auto; background: #fff; border: 1.5px solid #b0914f; border-radius: 0px; box-shadow: 10px 10px 0px #1a3c34; padding: 40px; position: relative;">
    
              
                <!-- Admin Calculator Header with Sync Dropdown -->
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px;">
                    <h3 style="margin: 0; color: #b0914f; font-family: 'Playfair Display', serif;">Jewellery Price Estimation</h3>

                    <!--switch on /off button-->
                    <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 15px;">
                        <span style="font-size: 12px; color: #1a3c34; font-weight: bold;">AUTO-CALCULATE:</span>
                        <label class="switch">
                            <input type="checkbox" id="autoCalcToggle">
                            <span class="slider round"></span>
                        </label>
                    </div>


                    <!-- Today's Rate Dropdown -->
                    <div class="rate-dropdown-container" id="rateDropdownContainer" style="position: relative; display: inline-block;">
                        <button class="today-rates-btn" style="background: #1a3c34; color: #ffd700; padding: 10px 20px; border: 1px solid #b0914f; cursor: pointer; font-family: 'Playfair Display', serif; border-radius: 25px;">
                            TODAY'S RATES <i class="fa fa-chevron-down"></i>
                        </button>
    
                        <div class="rate-dropdown-content" style=" display: none;  position: absolute; right: 0; top: 45px; background: #fdfaf3; border: 1.5px solid #b0914f; padding: 15px; width: 300px; z-index: 100; box-shadow: 0 10px 20px rgba(0,0,0,0.2);">
                            <h4 style="text-align: center; color: #1a3c34; margin-top: 0; border-bottom: 1px solid #b0914f; padding-bottom: 10px;">Live Market Rates</h4>
                            <table style="width: 100%; border-collapse: collapse; font-size: 14px; color: #1a3c34;">
                                <tr style="border-bottom: 1px solid #eee;"> <td style="padding: 8px 0;">Gold 24KT</td> <td style="text-align: right; font-weight: bold;"><span id="rate24">₹--</span>/gm</td> </tr>
                                <tr style="border-bottom: 1px solid #eee;"> <td style="padding: 8px 0;">Gold 22KT</td> <td style="text-align: right; font-weight: bold;"><span id="rate22">₹--</span>/gm</td> </tr>
                                <tr style="border-bottom: 1px solid #eee;"> <td style="padding: 8px 0;">Gold 18KT</td> <td style="text-align: right; font-weight: bold;"><span id="rate18">₹--</span>/gm</td> </tr>
                                <tr style="border-bottom: 2px solid #b0914f;"> <td style="padding: 8px 0;">Gold 14KT</td> <td style="text-align: right; font-weight: bold;"><span id="rate14">₹--</span>/gm</td> </tr>
                                <tr style="border-bottom: 1px solid #eee;"> <td style="padding: 8px 0;">Silver</td> <td style="text-align: right; font-weight: bold;"><span id="rateSilver">₹--</span>/gm</td> </tr>
                            </table>
                            <p style="font-size: 10px; color: #666; margin-top: 10px; font-style: italic;">*Prices exclude GST & Making Charges</p>
                        </div>
                    </div> 
                </div> <!-- Header Div Band -->
              
                <!-- Inputs Row -->
                <div style="display: flex; gap: 20px; flex-wrap: wrap; margin-bottom: 30px; align-items: flex-start;">
    
                    <!-- Current Rate -->
                    <div style="flex: 1; min-width: 200px;">
                        <label style="font-family: 'Playfair Display', serif; color: #1a3c34; font-weight: bold; display: block; margin-bottom: 10px; text-transform: uppercase; font-size: 12px; letter-spacing: 0.5px;">Current Rate (per gram)</label>
                        <input type="number" id="calcCurrentRate" oninput="checkAutoCalc()"  style="border: 1px solid #b0914f; padding: 12px; width: 100%; outline: none; background: #fdfaf3; box-sizing: border-box;" placeholder="Enter rate">
                    </div>


                    <!--WEIGHTS-->
                    <div style="flex: 1; min-width: 200px;">
                        <label style="font-family: 'Playfair Display', serif; color: #1a3c34; font-weight: bold; display: block; margin-bottom: 10px; text-transform: uppercase; font-size: 12px; letter-spacing: 0.5px;">Weight (Grams)</label>

                        <!-- Weight Dropdown Options -->
                        <select id="calcWeightSelect" onchange="toggleCustomWeightInput()" style="border: 1px solid #b0914f; padding: 12px; width: 100%; background: #fdfaf3; outline: none; box-sizing: border-box;">
                            <option value="1">1 Gram</option>
                            <option value="2">2 Grams</option>
                             <option value="3">3 Grams</option>
                              <option value="4">4 Grams</option>
                            <option value="5">5 Grams</option>
                            <option value="10">10 Grams (1 Tola)</option>
                            <option value="custom">-- Enter Custom Weight --</option>
                        </select>

                        <!-- Custom Weight Input Box (Shows only when Custom is selected) -->
                        <input type="number" id="calcCustomWeight" step="0.01" oninput="checkAutoCalc()" style="display:none; border: 1px solid #b0914f; padding: 12px; width: 100%; margin-top: 10px; background: #fff; box-sizing: border-box;" placeholder="Enter weight in grams (e.g. 15.5)">
                    </div>

                    <!-- Making Charges -->
                    <div style="flex: 1; min-width: 150px;">
                        <label style="font-weight: bold; display: block; margin-bottom: 5px; color: #555; font-size: 13px;">MAKING (%)</label>
                        <select id="calc-making-list" class="form-control" style="width: 100%; height: 40px; border: 1px solid #d4af37;" onchange="calculateTotalEstimation()">
                        </select>
                    </div>
                </div>

                <div style="display: flex; align-items: center; gap: 15px; justify-content: space-between;">

                  

              <div class="input-group" style="flex: 1; min-width: 200px;">
    <label style="font-family: 'Playfair Display', serif; color: #1a3c34; font-weight: bold; display: block; margin-bottom: 10px; text-transform: uppercase; font-size: 12px; letter-spacing: 0.5px;">GST (%)</label>
    
    <!-- GST Dropdown Options (Default 3% Selected) -->
    <select id="calcGST" onchange="toggleCustomGSTInput()" class="form-control" style="border: 1px solid #b0914f; padding: 12px; width: 100%; background: #fdfaf3; outline: none; box-sizing: border-box;">
        <option value="0">0% (None)</option>
        <option value="3" selected>3% (Standard Jewelry)</option>
        <option value="5">5%</option>
        <option value="12">12%</option>
        <option value="18">18%</option>
        <option value="custom">-- Enter Custom GST % --</option>
    </select>

    <!-- Custom GST Input Box (Shows only when Custom is selected) -->
    <input type="number" id="calcCustomGST" step="0.1" oninput="calculateTotalEstimation()" style="display:none; border: 1px solid #b0914f; padding: 12px; width: 100%; margin-top: 10px; background: #fff; box-sizing: border-box;" placeholder="Enter GST % (e.g. 5, 12, 28)">
</div>

                <!-- Result Box -->
                    <div id="calcResult" style="  display: none; transition: all 0.5s ease-in-out; margin-bottom: 20px; padding: 20px; background: #1a3c34; border: 1px solid #b0914f; text-align: center; border-radius: 8px;">
                    <p style="font-family: 'Playfair Display', serif; color: #ffd700; font-style: italic; margin: 0; font-size: 14px;">Total Estimated Price (Incl. GST):</p>
                    <h1 id="finalPriceDisplay" style="color: #ffffff; font-size: 2.5rem; margin: 5px 0 0 0; font-family: 'Playfair Display', serif;">₹ 0.00</h1>
                    </div>

                <!-- Button -->
                    <button onclick="calculateTotalEstimation()" class="action-btn-gold"
                            style="width: 50%; display: block !important; margin-left: auto !important; margin-right: auto !important; padding: 15px; background: #b0914f; color: white; border: none; transition: transform 0.2s;  font-family: 'Playfair Display' , serif; cursor: pointer; font-size: 18px; border-radius: 4px;">
                        Calculate Total
                    </button>
                    <button onclick="resetCalculator()" class="refresh-btn">
                        <i class="fa fa-refresh"></i> Refresh
                    </button>
                </div>
              
            </section> <!-- Section Band -->
        </div> <!-- Calculator Section Main Div Band -->
    
            
        <!-- Settings Section -->
        <!-- Settings Section Start -->
        <div id="settingsSection" class="content-div" style="display:none; padding: 20px; margin-left: 250px;">

            <!-- Row 1: Navigation Tabs -->
            <div class="row">
                <div class="col-md-12 d-flex justify-content-center">
                    <div style="display: flex; gap: 10px; width: 100%; max-width: 600px; margin-bottom: 25px;">
                        <button onclick="toggleSettingTab('update')" id="btnTabUpdate"
                                style="flex: 1; padding: 12px; border: none; border-bottom: 3px solid #d4af37; background: #fff; cursor: pointer; font-weight: bold; color: #d4af37;">
                            Update Profile
                        </button>
                        <button onclick="toggleSettingTab('create')" id="btnTabCreate"
                                style="flex: 1; padding: 12px; border: none; border-bottom: 3px solid transparent; background: #fff; cursor: pointer; font-weight: bold; color: #666;">
                            Create New Admin
                        </button>
                    </div>
                </div>
            </div>

            <!-- Row 2: Settings Form Cards -->
            <div class="row">
                <div class="col-md-12">
                    <div id="settingsActualContent" style="width: 100%; display: flex; flex-direction: column; align-items: center; gap: 20px;">

                        <!-- 1. Update Profile Tab -->
                        <div id="updateProfileTab" style="width: 100%; max-width: 600px; background: #fff; padding: 25px; border-radius: 12px; box-shadow: 0 5px 15px rgba(0,0,0,0.1); border-top: 4px solid #d4af37;">
                            <h3 style="color: #d4af37; margin-bottom: 20px;">Admin Profile Settings</h3>
                            <div class="setting-group" style="margin-bottom: 25px;">
                                <label style="font-weight: bold;">Update Username (8-12 characters):</label>
                                <input type="text" id="newUsername" class="form-control" autocomplete="off" placeholder="Enter New Username" style="width: 100%; margin-top: 10px; padding: 8px;">
                            </div>
                            <hr style="border: 0.5px solid #eee; margin: 20px 0;">
                            <div class="setting-group">
                                <h4 style="margin-bottom: 15px;">Change Password</h4>
                                <label>Old Password:</label>
                                <input type="password" id="oldPassword" placeholder="Puraana password" class="form-control" style="width: 100%; margin-bottom: 10px; padding: 8px;">
                                <label>New Password:</label>
                                <input type="password" id="newPassword" placeholder="Naya password" class="form-control" style="width: 100%; margin-bottom: 10px; padding: 8px;">
                                <label>Confirm New Password:</label>
                                <input type="password" id="confirmPassword" placeholder="Naya password dobara daalein" class="form-control" style="width: 100%; margin-bottom: 15px; padding: 8px;">
                                <button onclick="saveAdminSettings()" style="width: 100%; background: #000; color: #fff; padding: 12px; border: none; border-radius: 5px; cursor: pointer; font-weight: bold;">SAVE SETTINGS</button>
                            </div>
                        </div>

                        <!-- 2. Create New Admin Tab -->
                        <div id="createNewAdminTab" style="display: none; width: 100%; max-width: 600px; background: #fff; padding: 25px; border-radius: 12px; box-shadow: 0 5px 15px rgba(0,0,0,0.1); border-top: 4px solid #28a745;">
                            <h3 style="color: #28a745; margin-bottom: 20px;">Create New Admin Account</h3>
                            <div class="setting-group" style="margin-bottom: 15px;">
                                <label style="font-weight: bold;">New Admin Username:</label>
                                <input type="text" id="createAdminUser" placeholder="Enter new username" class="form-control" autocomplete="off" style="width: 100%; margin-top: 10px; padding: 8px;">
                            </div>
                            <div class="setting-group" style="margin-bottom: 20px;">
                                <label style="font-weight: bold;">Initial Password:</label>
                                <input type="password" id="createAdminPass" placeholder="Enter initial password" class="form-control" autocomplete="new-password" style="width: 100%; margin-top: 10px; padding: 8px;">
                            </div>
                            <button onclick="createNewAdminAccount()" style="width: 100%; background: #28a745; color: #fff; padding: 12px; border: none; border-radius: 5px; cursor: pointer; font-weight: bold;">CREATE ACCOUNT</button>
                        </div>

                    </div>
                </div>
            </div>

        </div>
        <!-- Settings Section End -->

   
   
        
        
</main>
    
    <!-- MODALS -->
    <div id="resetModal" class="custom-modal-overlay">
        <div class="custom-modal-box">
            <div class="modal-icon">⚠️</div>
            <h3>Reset Confirmation</h3>
            <p>Are you sure to reset all data? <br> <small>This action cannot be undone.</small></p>
            <div class="modal-buttons">
                <button class="btn-no" onclick="closeResetModal()">Cancel</button>
                <button class="btn-yes" onclick="executeReset()">Yes, Reset</button>
            </div>
        </div>
    </div>

    <div id="successModal" class="custom-modal-overlay" style="display:none;">
        <div class="custom-modal-box">
            <div class="modal-icon" id="modalIcon" style="color: #28a745;">✅</div>
            <h3 id="modalTitle">Success!>Success!</h3>
            <p id="successMessageText">Saved Successfully!</p>
            <div class="modal-buttons">
                <button class="btn-yes" onclick="closeSuccessModal()" style="background: #b0914f; width: 100%;">OK</button>
            </div>
        </div>
    </div>
   
    <script>
            // Image Preview function
            function handleImagePreview(input) {
                const file = input.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        document.getElementById('imgPreview').src = e.target.result;
                        document.getElementById('previewWrapper').style.display = 'block';
                    }
                    reader.readAsDataURL(file);
                }
            }

            <div id="toast-popup" style="display:none;">Done ✔</div>
    </script>
    <script src="https://kit.fontawesome.com/your-code.js" crossorigin="anonymous"></script>
    <script src="~/js/Admin.js"></script>
    <script>
            // This variable will pass the C# message to JavaScript

        var loginSuccessMessage = '@TempData["LoginSuccess"]';
    </script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</body>
</html>