@using System.Data
@model DataTable
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Admin - Ashok Jewellery Art</title>
  
    <!-- ========================================== -->
    <link rel="stylesheet" href="~/css/Admin.css" />
</head>
<body>

    <div class="admin-panel-container">
        <nav class="sidebar">
            <div class="brand-section">
                <h1>AJ ART</h1>
                <p>MANAGEMENT</p>
            </div>
            <!-- ========================================== -->
            <!-- SIDEBAR LIVE ANALYTICS SECTION START -->
            <!-- ========================================== -->
            <input type="checkbox" id="drawerToggleCheckbox" style="display: none;" />

            <div class="sidebar-analytics" style="padding: 20px 15px; border-bottom: 1px solid rgba(255,255,255,0.1); margin-bottom: 20px; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">

                <div class="sidebar-stat-item" style="display: flex; align-items: center; margin-bottom: 25px;">
                    <div style="background: rgba(255, 193, 7, 0.15); width: 40px; height: 40px; border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-right: 15px;margin-left: 18px; flex-shrink: 0;">
                        <span style="color: #ffc107; font-size: 18px; font-weight: bold;">👥</span>
                    </div>
                    <div style="margin-left: 20px;">
                        <p style="margin: 0 0 4px 0; font-size: 11px; opacity: 0.6; letter-spacing: 1px; text-transform: uppercase; color: #fff;">TOTAL VISITORS</p>
                        <h4 style="margin: 0; font-weight: 700; font-size: 22px; color: #fff; line-height: 1;">@ViewBag.TotalVisitors</h4>
                    </div>
                </div>

                <label for="drawerToggleCheckbox" style="display: flex; align-items: center; justify-content: space-between; background: rgba(255,255,255,0.06); padding: 12px 15px; border-radius: 8px; cursor: pointer; border: 1px solid rgba(0,203,198,0.2); box-shadow: 0 4px 10px rgba(0,0,0,0.1); transition: all 0.3s ease; user-select: none;">
                    <div style="display: flex; align-items: center;">
                        <div style="background: rgba(231, 76, 60, 0.2); width: 40px; height: 40px; border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-right: 15px; flex-shrink: 0;">
                            <span style="color: #e74c3c; font-size: 18px;">📍</span>
                        </div>
                        <div>
                            <p style="margin: 0 0 4px 0; font-size: 10px; opacity: 0.7; letter-spacing: 1px; text-transform: uppercase; color: #fff;">TOP LOCATION</p>
                            <h5 style="margin: 0; font-size: 14px; font-weight: 600; color: #00cbc6; line-height: 1;">@ViewBag.TopLocation</h5>
                        </div>
                    </div>

                    <div style="background: #00cbc6; color: #fff; width: 32px; height: 32px; border-radius: 6px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px; box-shadow: 0 3px 8px rgba(0,203,198,0.3);">
                        <span style="display: block; width: 14px; height: 2px; background: white; border-radius: 1px;"></span>
                        <span style="display: block; width: 14px; height: 2px; background: white; border-radius: 1px;"></span>
                        <span style="display: block; width: 14px; height: 2px; background: white; border-radius: 1px;"></span>
                    </div>
                </label>

            </div>
            <div id="locationDrawer" class="custom-side-drawer">

                <div style="background: #7b1fa2; color: white; padding: 15px 20px; display: flex; align-items: center; justify-content: space-between; box-shadow: 0 2px 5px rgba(0,0,0,0.1); flex-shrink: 0;">
                    <h5 style="margin: 0; font-size: 15px; font-weight: 600; display: flex; align-items: center; gap: 8px;">
                        📊 Visitor Logs (Ashok Jewellery Art)
                    </h5>
                    <label for="drawerToggleCheckbox" style="color: white; font-size: 28px; cursor: pointer; line-height: 1; opacity: 0.8; padding: 2px 8px;">&times;</label>
                </div>

                <div style="flex: 1; padding: 15px; background: #f8f9fa; display: flex; flex-direction: column; overflow: hidden;">

                    <div class="table-scroll-zone" style="height: 290px !important; max-height: 290px !important; overflow-y: scroll !important; overflow-x: auto !important; border: 1px solid #dee2e6; border-radius: 8px; background: #fff; box-shadow: 0 2px 8px rgba(0,0,0,0.05);">

                        <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 12px; margin: 0; table-layout: fixed;">

                            <thead style="position: sticky; top: 0; background: #343a40; z-index: 99;">
                                <tr style="color: white;">
                                    <th style="padding: 10px; width: 35px; text-align: center; background: #343a40;">#</th>
                                    <th style="padding: 10px; width: 110px; background: #343a40;">IP Address</th>
                                    <th style="padding: 10px; width: 110px; background: #343a40;">Location</th>
                                    <th style="padding: 10px; width: 130px; background: #343a40;">Visit Date & Time</th>
                                </tr>
                            </thead>

                            <tbody>
                                @if (ViewBag.AllLocationsList != null)
                                {
                                    int index = 1;
                                    foreach (var log in (List<Dictionary<string, string>>)ViewBag.AllLocationsList)
                                    {
                                        <tr style="border-bottom: 1px solid #dee2e6;">
                                            <td style="padding: 10px; text-align: center; font-weight: bold; color: #666; background: #fdfdfd;">@index</td>
                                            <td style="padding: 10px; word-wrap: break-word; white-space: normal;"><code style="color: #e83e8c; font-family: monospace; font-size: 11px; font-weight: 600;">@log["Ip"]</code></td>
                                            <td style="padding: 10px; word-wrap: break-word; white-space: normal; color: #333; font-weight: 500;">📍 @log["Loc"]</td>
                                            <td style="padding: 10px; color: #666; font-size: 11px;">
                                                @(log.ContainsKey("Date") ? log["Date"] : DateTime.Now.ToString("dd-MM-yyyy hh:mm tt"))
                                            </td>
                                        </tr>
                                        index++;
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" style="padding: 25px; text-align: center; color: #dc3545; font-weight: bold;">No records found.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                    </div>
                </div>
            </div>
          
            <!-- SIDEBAR LIVE ANALYTICS SECTION END -->
            <ul class="nav-links">
                <li class="active">
                    <!-- Products Tab -->
                    <a id="prodLink" href="javascript:void(0)" onclick="switchSection('productInventorySection')">Products</a>
                </li>
                <li>
                    <!-- Multi-Products Tab -->
                    <a id="multiProdLink" href="javascript:void(0)" onclick="switchSection('multiProductsSection')">Multi-Products</a>
                </li>
                <li>
                    <!-- Orders Tab -->
                    <a id="ordLink" href="javascript:void(0)" onclick="switchSection('ordersSection')">Orders</a>
                </li>
                <li>
                    <!-- Calculator Tab -->
                    <a id="calcLink" href="javascript:void(0)" onclick="switchSection('calculatorSection')">Price Calculator</a>
                </li>
                <li>
                    <!-- Settings Tab -->
                    <a class="settings-card-box" id="settingTabBtn" href="javascript:void(0)" onclick="switchSection('settingsSection')">Settings</a>
                </li>
               
            </ul>
        </nav>
        </div>

       <main class="main-content">
        <div class="top-nav-wrapper" >
                <a href="/" class="back-home-btn">
                    <span class="arrow-icon">←</span> Back to Home
                </a>
            </div>
        <div id="productInventorySection">
            <header class="content-header">
                <h2>Product Inventory</h2>
                <div class="admin-welcome-badge">
                    <span class="welcome-text">Welcome,</span>
                    <span class="admin-name">ADMIN</span>
                    <span class="verified-icon">
                        <svg viewBox="0 0 24 24" width="16" height="16">
                            <path fill="currentColor" d="M23,12L20.56,9.22L20.9,5.54L17.29,4.72L15.4,1.54L12,3L8.6,1.54L6.71,4.72L3.1,5.53L3.44,9.21L1,12L3.44,14.78L3.1,18.47L6.71,19.29L8.6,22.47L12,21L15.4,22.46L17.29,19.28L20.9,18.46L20.56,14.78L23,12M10,17L6,13L7.41,11.59L10,14.17L16.59,7.58L18,9L10,17Z"></path>
                        </svg>
                    </span>
                </div>
            </header>

        

        <!-- NEW DIRECT UPLOAD SECTION START-->
            <div class="admin-card mt-5 shadow-lg">
                <div class="admin-header">
                    <h3><i class="fas fa-gem me-2"></i> DIRECT UPLOAD - ASHOK JEWELLERY ART</h3>
                </div>
    
                <div class="admin-body">
                    <div class="row g-4">
                        <!-- Image Upload Box -->
                        <div class="col-md-4">
                            <div class="upload-wrapper">
                                <label for="direct-image" class="upload-box" id="drop-area">
                                    <input type="file" id="direct-image" hidden accept="image/*" onchange="previewDirectImage(event)">
                                    <div id="preview-content" class="text-center">
                                        <i class="fas fa-cloud-upload-alt fa-3x mb-3 text-success"></i>
                                        <p class="mb-2 fw-bold">Ready to add new item?</p>
                                        <span class="upload-btn-styled">CHOOSE PHOTO</span>
                                    </div>
                                    <img id="direct-preview" class="img-fluid d-none shadow-sm rounded">
                                </label>
                            </div>
                        </div>

                        <!-- Inputs Section -->
                        <div class="col-md-8">
                            <div class="row g-3">
                                <!-- Collection Dropdown -->
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Select Collection</label>
                                    <select id="direct-collection" class="form-select custom-input" onchange="toggleGemstoneView()">
                                        <!-- Gold Categories -->
                                        <optgroup label="Gold Collection">
                                            <option value="Gold">General Gold Collection</option>
                                            <option value="Gold Bangles">Gold Bangles</option>
                                            <option value="Gold Chains">Gold Chains</option>
                                            <option value="Gents Rings">Gents Rings</option>
                                            <option value="Kids Bracelet">Kids Bracelet</option>
                                            <option value="Kids Mangati">Kids Mangati</option>
                                            <option value="Gold Earring">Gold Earring</option>
                                            <option value="Kids Ring">Kids Ring</option>
                                            <option value="Gold Mangalsutra">Gold Mangalsutra</option>
                                            <option value="Mangalsutra Pendants">Mangalsutra Pendants</option>
                                            <option value="Gold Coins">Gold Coins</option>
                                            <option value="Ladies Rings">Ladies Rings</option>
                                            <option value="Gold Bracelets">Gold Bracelets</option>
                                            <option value="Gold Pendants">Gold Pendants</option>
                                            <option value="Gold Necklace">Gold Necklace</option>
                                            <option value="Dorle Pendant">Dorle Pendant</option>
                                            <option value="Jhumka">Jhumka</option>
                                            <option value="Patta Mangalsutra">Patta Mangalsutra</option>
                                            <option value="Bridal Necklace">Bridal Necklace</option>
                                            <option value="Gold Tops">Gold Tops</option>
                                            <option value="Nath">Nath</option>
                                            <option value="Short Poth">Short Poth</option>
                                            <option value="Rounded Ring">Rounded Ring</option>
                                            <option value="Ranihaar">Ranihaar</option>
                                            <option value="Laxmi Har">Laxmi Har</option>
                                            <option value="Bormani Maal">Bormani Maal</option>
                                            <option value="Pohehaar">Pohehaar</option>
                                            <option value="Kanthi Choker">Kanthi Choker</option>
                                            <option value="EarChain">EarChain</option>
                                            <option value="Nosepins">Nosepins</option>
                                            <option value="Basket Earrings">Basket Earrings</option>
                                            <option value="RoseGold Ring">RoseGold Ring</option>
                                        </optgroup>

                                        <!-- Silver Categories -->
                                        <optgroup label="Silver Collection">
                                            <option value="Silver">General Silver Collection</option>
                                            <option value="Silver Earrings">Silver Earrings</option>
                                            <option value="Silver Utensils">Silver Utensils</option>
                                            <option value="Pooja Items">Pooja Items</option>
                                            <option value="Silver Idol">Silver Idol</option>
                                            <option value="Silver Studs">Silver Studs</option>
                                            <option value="Silver Articles">Silver Articles</option>
                                            <option value="Silver Anklets">Silver Anklets</option>
                                            <option value="Silver Karanda">Silver Karanda</option>
                                            <option value="Silver Door Hanging">Silver Door Hanging</option>
                                            <option value="Silver Gents Rings">Silver Gents Rings</option>
                                            <option value="Silver Ladies Rings">Silver Ladies Rings</option>
                                            <option value="Silver Kids Rings">Silver Kids Rings</option>
                                            <option value="Silver Nosepins">Silver Nosepins</option>
                                            <option value="Silver Bracelets">Silver Bracelets</option>
                                            <option value="Silver Kids Bracelets">Silver Kids Bracelets</option>
                                            <option value="Silver Pendants">Silver Pendants</option>
                                            <option value="Silver Bangles">Silver Bangles</option>
                                            <option value="Chain Anklets">Chain Anklets</option>
                                            <option value="Silver Chains">Silver Chains</option>
                                            <option value="Silver Toe Rings">Silver Toe Rings</option>
                                            <option value="Silver Kambarpatta">Silver Kambarpatta</option>
                                            <option value="Silver Krishna Saaj">Silver Krishna Saaj</option>
                                            <option value="Silver Karnful">Silver Karnful</option>
                                            <option value="Silver Coins">Silver Coins</option>
                                        </optgroup>

                                        <!-- Diamond Categories -->
                                        <optgroup label="Diamond Collection">
                                            <option value="Diamond">General Diamond Collection</option>
                                            <option value="Diamond Rings">Diamond Rings</option>
                                            <option value="Diamond Earrings">Diamond Earrings</option>
                                            <option value="Diamond Bracelets">Diamond Bracelets</option>
                                            <option value="Diamond Pendants">Diamond Pendants</option>
                                            <option value="Diamond Bangles">Diamond Bangles</option>
                                            <option value="Diamond Mangalsutra">Diamond Mangalsutra</option>
                                        </optgroup>

                                        <!-- Gemstone Categories -->
                                        <optgroup label="Gemstone Collection">
                                            <option value="Gemstone">General Gemstone Collection</option>
                                            <option value="Gemstones">Gemstones</option>
                                            <option value="Gemstone Rings">Gemstone Rings</option>
                                            <option value="Emerald Special">Emerald Special</option>
                                            <option value="Gemstone Pendants">Gemstone Pendants</option>
                                            <option value="Gemstone Bracelets">Gemstone Bracelets</option>
                                        </optgroup>

                                        <!-- Other Collections -->
                                        <optgroup label="Other Collections">
                                            <option value="DailyWear">Daily Wear Collection</option>
                                            <option value="New Arrival">New Arrival</option>
                                            <option value="Trending">Trending Collection</option>
                                            <option value="1 Gram Gold">1 Gram Gold</option>
                                            <option value="Bridal">Bridal Collection</option>
                                        </optgroup>
                                    </select>
                                </div>
                               
                                <!--metal type-->
                                <div class="col-md-6" id="metal-type-section">
                                    <label class="form-label fw-bold">Select Metal</label>
                                    <select id="direct-metal-type" name="MetalType" class="form-select custom-input">
                                        <option value="Gold">Gold</option>
                                        <option value="Silver">Silver</option>
                                        <option value="Diamond">Diamond</option>
                                        <option value="Gemstone">Gemstone</option>
                                        <option value="Rose Gold">Rose Gold</option>
                                    </select>
                                </div>
                                <!-- Material Type Dropdown -->
                                <div class="col-md-6" id="material-section">
                                    <label class="form-label fw-bold">Material Type</label>
                                    <select id="direct-material" name="MaterialType" class="form-select custom-input" oninput="calculatePrice()" >
                                     <!-- Gold Options -->
                                        <option value="24K">24K Gold</option>
                                           <option value="22K">22K Gold</option>
                                      <option value="18K">18K Gold</option>
                                      <option value="14K">14K Gold</option>
        
                                     <!-- Silver Options -->
                                            <option value="925 Silver">925 Sterling Silver</option>
                                          <option value="999 Silver">999 Pure Silver</option>
                                          <option value="Chandi">Normal Silver (Chandi)</option>
                                           <option value="Silver">Silver</option>

                                   <!-- Diamond Options -->
                                   <option value="VVS-EF">VVS - EF (Diamond)</option>
                                     <option value="VVS-GH">VVS - GH (Diamond)</option>
                                           <option value="VS-GH">VS - GH (Diamond)</option>
                                      <option value="SI-HI">SI - HI (Diamond)</option>

                                    <!-- Gemstone Options (Requested List) -->
                                 <option value="Emerald">Emerald (Panna)</option>
                                  <option value="Ruby">Ruby (Manik)</option>
                                  <option value="Yellow Sapphire">Yellow Sapphire (Pukhraj)</option>
                                  <option value="Blue Sapphire">Blue Sapphire (Neelam)</option>
                                     <option value="Hessonite">Hessonite (Gomed)</option>
                                   <option value="Pearl">Pearl (Moti)</option>
                                    <option value="Amethyst">Amethyst</option>
                                   <option value="Navratna">Navratna (9 Gems)</option>
                                   <option value="Other Gemstone">Other Gemstone</option>

                                     <!-- Other -->
                                    <option value="Other">Other (Manual)</option>
                                       </select>
                                </div>
                              

                                <!-- Product Title -->
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Product Title</label>
                                    <input list="product-suggestions" id="direct-title" class="form-control custom-input" placeholder="Type or Select Product Name" autocomplete="off">
                                    <datalist id="product-suggestions">
                                        <option value="1 Gram Gold"></option>
                                        <option value="Amethyst (Jamuniya)"></option>
                                        <option value="Anklets (Payal)"></option>
                                        <option value="Bangles & Bracelets"></option>
                                        <option value="Basket Rings"></option>
                                        <option value="Bor Mani Maal (Berry Beads)"></option>
                                        <option value="Bridal Collection"></option>
                                        <option value="Chains"></option>
                                        <option value="Chokers (Kanthi)"></option>
                                        <option value="Coral (Moonga)"></option>
                                        <option value="Daily Wear"></option>
                                        <option value="Diamond Mangalsutra"></option>
                                        <option value="Diamond Necklaces"></option>
                                        <option value="Earrings"></option>
                                        <option value="Emerald (Panna)"></option>
                                        <option value="Gomed (Hessonite)"></option>
                                        <option value="Gold Coin"></option>
                                        <option value="Jhumkas"></option>
                                        <option value="Karnphul (Earflowers)"></option>
                                        <option value="Krishna Saaj"></option>
                                        <option value="Kumkum Box (Karanda)"></option>
                                        <option value="Mangal Oval"></option>
                                        <option value="Mangalsutra"></option>
                                        <option value="Navratna Set"></option>
                                        <option value="Necklace"></option>
                                        <option value="Nose Stud (Nath)"></option>
                                        <option value="Nosepins"></option>
                                        <option value="Oanes Emerald"></option>
                                        <option value="Party Wear"></option>
                                        <option value="Pearl (Moti)"></option>
                                        <option value="Pendant"></option>
                                        <option value="Ranihaar (Queen Necklace)"></option>
                                        <option value="Ring"></option>
                                        <option value="Ruby (Manik)"></option>
                                        <option value="Sapphire (Neelam)"></option>
                                        <option value="Short Mangalsutra"></option>
                                        <option value="Silver Coins"></option>
                                        <option value="Silver Idols"></option>
                                        <option value="Silver Utensils"></option>
                                        <option value="Solitaire Ring"></option>
                                        <option value="Studs & Tops"></option>
                                        <option value="Toe Rings (Bichhiya)"></option>
                                        <option value="Toran (Door Hanging)"></option>
                                        <option value="Waist Belts (Kambar Patta)"></option>
                                        <option value="Wedding Rings"></option>
                                        <option value="Wedding Wear"></option>
                                    </datalist>
                                </div>
                                <!-- Weight with Incremental Dropdown + Manual -->
                                <!-- 1. Grams Section (for Gold/Silver ) -->
                                <div class="col-md-6" id="weight-grams-section" style="display: block;">
                                    <label class="form-label fw-bold">Weight (Grams)</label>
                                    <input list="weight-options" id="direct-weight" class="form-control custom-input" placeholder="Select or Type Weight" oninput="calculatePrice()" >
                                    <datalist id="weight-options"></datalist>
                                </div>

                                <!-- 2. Carat Section (Gemstone ) -->
                                <div class="col-md-6" id="weight-carat-section" style="display: none;">
                                    <label class="form-label fw-bold">Weight (Carats)</label>
                                    <div class="input-group">
                                        <input list="carat-options" id="direct-carat" class="form-control custom-input" placeholder="Type weight or select..." oninput="calculateInstantPrice()">
                                        <span class="input-group-text">ct</span>
        
                                        <datalist id="carat-options">
                                            <option value="1.00">1.00 ct (Ek Carat)</option>
                                            <option value="1.25">1.25 ct (Sava Ratti)</option>
                                            <option value="1.50">1.50 ct (Dedh Carat)</option>
                                            <option value="2.00">2.00 ct (Do Carat)</option>
                                            <option value="2.25">2.25 ct</option>
                                            <option value="3.25">3.25 ct</option>
                                            <option value="4.25">4.25 ct (Paune Paanch)</option>
                                            <option value="5.25">5.25 ct (Sava Paanch)</option>
                                        </datalist>
                                    </div>
                                    <small class="text-muted" style="font-size: 10px;">*Admin manual type bhi kar sakte hain (e.g. 1.10, 2.50)</small>
                                </div>

                                <!--diamond dropdown open-->
                                <div class="col-md-6" id="weight-diamond-section" style="display: none;">
                                    <label class="form-label fw-bold">Diamond Weight (Carats)</label>
                                    <div class="input-group">
                                        <input list="diamond-carat-options" id="direct-diamond-carat" class="form-control custom-input" placeholder="Type weight (e.g. 1.05)" oninput="calculatePrice()">
                                        <span class="input-group-text bg-dark text-white">ct</span>
        
                                        <datalist id="diamond-carat-options">
                                            <option value="0.50">0.50 ct</option>
                                            <option value="1.00">1.00 ct</option>
                                            <option value="1.50">1.50 ct</option>
                                            <option value="2.00">2.00 ct</option>
                                            <option value="2.50">2.50 ct</option>
                                        </datalist>
                                    </div>
                                    <small class="text-muted" style="font-size: 10px;">*Aap yahan koi bhi weight manually type kar sakte hain.</small>
                                </div>
                                <!--GENDER-->
                              <div class="form-group mb-3">
                                      <label style="font-weight: bold;">Select Gender</label>
                                   <select name="pGender" id="pGender" class="form-control" style="height: 40px; border: 1px solid #ced4da;">
                                     <option value="Women">Women</option>
                                     <option value="Men">Men</option>
                                     <option value="Kids">Kids</option>
                                     <option value="Unisex" selected>Unisex</option>
                                   </select>
                              </div>
                                <!--price calculation-->
                                <div class="col-md-6 mt-3">
                                    <div class="rate-input-wrapper mb-3" style="max-width: 300px;">
                                        <label class="form-label fw-bold text-muted mb-1" style="font-size: 12px; letter-spacing: 0.5px;">
                                            MARKET RATE (1G)
                                        </label>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text bg-white border-gold text-gold" style="border-color: #d4af37; color: #d4af37;">₹</span>
                                            <input type="number" id="manual-live-rate"
                                                   class="form-control border-gold"
                                                   style="border-color: #d4af37; font-weight: bold;"
                                                   placeholder="0.00" oninput="calculatePrice()">
                                        </div>
                                    </div>
                                </div>

                                <!-- Price Display -->
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Estimated Price (₹)</label>
                                    <div class="price-tag">
                                        <span id="direct-price">₹ 0</span>
                                    </div>
                                </div>

                                <!-- Action Buttons -->
                                <div class="col-md-6 d-flex align-items-end gap-2">
                                    <button class="btn btn-gold w-100 p-2" onclick="saveDirectProduct()">
                                        <i class="fas fa-check-circle me-1"></i> DONE & SAVE
                                    </button>
                                    <!--Clear Button-->
                                    <button class="btn btn-clear-custom w-100 p-2" onclick="resetAdminForm()">
                                        <i class="fas fa-undo-alt me-1"></i> CLEAR FORM
                                    </button>
                                </div>
